{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "website",
    "region": "eu-west4-drams3a",
    "edgeHttps": false,
    "disableHttpsRedirect": true,
    "restartPolicyType": "ON_FAILURE"
  }
}
